# dependencies
/node_modules
/.pnp
.pnp.js

# production
# This folder is created when you run `npm run build` or `yarn build`
/build
/dist

# local environment variables
# This is crucial for keeping your secret keys out of the repository.
# The `create-react-app` template includes more specific patterns,
# but ignoring all `.env` files is a safer and more universal approach.
.env
.env.local
.env.*.local

# typescript specific
# TypeScript caches are unnecessary to commit.
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# testing and coverage
/coverage

# editor and OS files
# Ignore files and folders generated by editors like VS Code and OSs.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Other caches and generated files
.npm/
.eslintcache
.stylelintcache

# If you use a different package manager, add its specific lockfile
# You should commit `package-lock.json` or `yarn.lock` but ignore others.
# pnpm-lock.yaml

# If you are using Storybook
.storybook-cache/
